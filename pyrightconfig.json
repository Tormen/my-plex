{
  // my-plex runs inside its own venv (~/.python.venv/my-plex, created on first
  // run), so pyright needs that interpreter to resolve plexapi and readchar.
  // No path is recorded here -- run pyright with the venv active, or pass
  // --pythonpath; README, "Type checking", has the command.
  //
  // standard, not strict: strict reports 23540 findings on my-plex.py, which
  // is a wall rather than a gate.  Strict is the goal; TODO.local.md tracks it.
  "include": ["my-plex.py", "my-plex_tests.py"],
  "exclude": ["playground", "__pycache__"],
  "typeCheckingMode": "standard"
}
